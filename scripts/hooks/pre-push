#!/bin/sh
# Repo pre-push hook — mechanical enforcement of Standing Rule #1
# (ClawDog Git Protocol: never push to master / main; use clawdog/* branches
# and human sign-off via PR).
#
# This hook converts Standing Rule #1 from a recall-rule into a binary-failure
# boundary (per Lesson #35 — behavioural recall rules drift; binary-failure
# rules don't). Mirrored from clawdog-brain's mc25 hardening
# (`scripts/hooks/pre-push`); CLAWDOG/110 §3.5 Non-Negotiable #5 inheritance.
#
# Bypass is the standard `git push --no-verify`. Git skips ALL pre-push hooks
# when --no-verify is passed, which is the native, audit-trail-leaving signal
# of "I am deliberately bypassing." Administrative pushes (e.g. emergency
# rollback) should use --no-verify and surface that fact in the commit thread.
#
# Mode-B exit-code contract (mirroring Standing Rule #8):
#   0  🟢 CLEAN          — push targets only non-protected refs; proceed.
#   1  🔴 RULE #1 VIOLATION — push targets a protected ref; halt.
#   2  🟡 INFRA BROKEN    — repo or environment unreadable; halt and alert.
#
# Protected refs are configurable via env var:
#   CLAWDOG_PRE_PUSH_PROTECTED_REFS="refs/heads/master refs/heads/main"
# (space-separated; default shown above).
#
# Stdin protocol (per githooks(5)):
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# One line per ref being pushed. We only inspect <remote_ref>.
#
# Install: ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
# (or run `make install-hooks` from the repo root).

set -u

PROTECTED_REFS="${CLAWDOG_PRE_PUSH_PROTECTED_REFS:-refs/heads/master refs/heads/main}"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "pre-push: 🟡 INFRA BROKEN — not inside a git working tree (git rev-parse failed)" >&2
    exit 2
fi

violation_found=0
violating_refs=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue

    for protected in $PROTECTED_REFS; do
        if [ "$remote_ref" = "$protected" ]; then
            violation_found=1
            violating_refs="${violating_refs}  - ${remote_ref} (local: ${local_ref:-<deletion>} ${local_sha:-<none>})\n"
            break
        fi
    done
done

if [ "$violation_found" -eq 1 ]; then
    printf '\n' >&2
    printf '🔴 STANDING RULE #1 VIOLATION — push to protected ref refused.\n' >&2
    printf '\n' >&2
    printf 'Standing Rule #1 (ClawDog Git Protocol):\n' >&2
    printf '  Never commit or push to main / master. All writes go through a\n' >&2
    printf '  clawdog/* branch + PR + human sign-off.\n' >&2
    printf '\n' >&2
    printf 'Refused push targets:\n' >&2
    printf "$violating_refs" >&2
    printf '\n' >&2
    printf 'If this is a deliberate, audit-trail-leaving administrative push,\n' >&2
    printf 'bypass with:  git push --no-verify\n' >&2
    printf '\n' >&2
    printf 'Otherwise: open a PR from a clawdog/* branch and let Andrew merge.\n' >&2
    printf '\n' >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Layer 2 (mc16-2026-05-25): deploy-YAML placeholder guard.
#
# Watch-pattern: `gcloud run services replace` honours placeholder env
# values in deploy/*.yaml, silently clobbering working out-of-band
# `--set-env-vars` overrides and taking production to HTTP 500.
#
# Layer 2 exit-code contract (mirroring Standing Rule #8):
#   0  🟢 CLEAN          — no placeholders detected.
#   1  🔴 LOGIC DRIFT    — placeholder detected; fix or allowlist.
#   2  🟡 INFRA BROKEN   — scanner could not run; halt and alert.
# ---------------------------------------------------------------------------
guard_script="scripts/check_deploy_placeholders.py"
if [ -f "$guard_script" ]; then
    if ! python3 "$guard_script" >&2; then
        gs_exit=$?
        printf '\n' >&2
        if [ "$gs_exit" = "2" ]; then
            printf '🟡 deploy-placeholder guard: INFRA BROKEN (exit 2).\n' >&2
            printf 'Halt and alert a human; do not bypass with --no-verify.\n' >&2
            exit 2
        fi
        printf '🔴 deploy-placeholder guard: LOGIC DRIFT (exit %s).\n' "$gs_exit" >&2
        printf 'Fix the placeholder value(s) above before pushing.\n' >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Layer 3 (mc00-2026-09-04, Fable 05:34 UTC ruling; scope-corrected by
# Fable 05:41 UTC ruling):
#
# Full-CI-mirror `make gates` on every push.
#
# **This layer is a feedback-loop shortener, NOT the enforcement.**
#
# Fable 05:41 UTC ruling (verbatim):
#   "The pre-push hook is not the enforcement. Say so, or someone will
#    rely on it. A hook with --no-verify and SKIP_GATES=1 is a feedback-
#    loop shortener, not a gate. That is a perfectly good thing to be,
#    and it will save real time. But the enforcement is CI, and only if
#    branch-protection required-status-checks lists the CI job.
#
#    Record it that way, because the failure mode of mislabelling it is
#    precise: a future session sees 'mechanical enforcement installed',
#    trusts the hook, bypasses it once under pressure, and pushes red
#    believing the system would have stopped it."
#
# What this hook DOES do (well):
#   - Catches ~all cases where the author forgot to run `make gates` before
#     `git push`, in the ~1s it takes to fail rather than the ~30s CI takes.
#   - Emits the exact same failure text the author would have seen from
#     `make gates` directly, at the point of intent to push.
#
# What this hook does NOT do (do not rely on it for these):
#   - Prevent `git push --no-verify` from bypassing all pre-push hooks
#     entirely (this is git's own bypass covenant; the hook has no say).
#   - Prevent `SKIP_GATES=1 git push` from bypassing only Layer 3.
#   - Prevent the ~5% of cases where a subtle env/config drift produces
#     local-green / CI-red (this is what the ruff pin-parity check in
#     `make gates` targets; but drift outside ruff can still slip past).
#   - Prevent a red PR from being merged. That is a CI required-status-
#     check + branch-protection job — which as of mc00-2026-09-04
#     05:42 UTC is NOT configured on `main` (wire-verified via
#     `GET /repos/lodgeit-labs/clawdog-calculator-api/branches/main/
#     protection` returning HTTP 404 "Branch not protected"). Andrew-
#     action brief for adding it: docs/andrew-action-add-branch-
#     protection.md.
#
# The enforcement is CI + required-status-checks. This hook is the fast
# feedback loop between author intent and CI knowing. Two different jobs.
#
# Anchor for the fast-feedback-loop shape: mc00-2026-09-04 twice-in-a-row
# local-green-CI-red divergence on PR #33 (commits ee01713 + 405cdb6).
# Both times ClawDog ran pytest locally without running ruff and reported
# "green"; both times CI's `ruff check api tests` step 6 failed with
# I001/F401 before pytest was ever reached. `make gates` closes that
# specific gap (author forgetting to run a step) by making the push run it.
#
# Bypass:
#   git push --no-verify   — skips ALL pre-push hooks (git covenant).
#   SKIP_GATES=1 git push  — skips ONLY Layer 3.
# Both are auditable via shell history; both are legitimate for exec
# environments where the venv is unavailable or for emergency rollback.
if [ -z "${SKIP_GATES:-}" ]; then
    printf '\n' >&2
    printf 'pre-push Layer 3: running `make gates` (Fable mc00-2026-09-04 discipline).\n' >&2
    printf 'This is a feedback-loop shortener, NOT the enforcement. The\n' >&2
    printf 'enforcement is CI + branch-protection required-status-checks.\n' >&2
    printf 'To bypass in an emergency: git push --no-verify\n' >&2
    printf 'To skip only Layer 3:     SKIP_GATES=1 git push\n' >&2
    printf '\n' >&2
    if ! make gates >&2; then
        gates_exit=$?
        printf '\n' >&2
        printf '🔴 pre-push Layer 3: `make gates` failed (exit %s).\n' "$gates_exit" >&2
        printf 'CI would fail this push. Fix the failing gate above and retry.\n' >&2
        printf '\n' >&2
        exit 1
    fi
fi

exit 0
