# D53 (Fable [CALC] 2026-09-30): keep the Cloud Run source-deploy upload lean.
# Excludes test/fixture/docs/VCS material that the runtime image never needs,
# so `gcloud run deploy --source .` builds a smaller, faster context.
#
# NOTE: .gcloudignore does NOT affect the local test/gates suite; it only
# scopes what is uploaded to Cloud Build for the container image.

# Version control
.git/
.gitignore
.github/

# Tests and fixtures (not part of the runtime image)
tests/
**/tests/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Docs (explicit excludes — a blanket *.md rule would also drop the
# rate_tables/SBRM_RATE_TABLE/**/*.md files the Dockerfile COPYs into the
# image at build time, which caused the FY2026 manifest_rate_table_unavailable
# 502 on canaries 00065/00067. D53b (Fable [CALC] 2026-09-30).
docs/
CHANGELOG*.md
*_body.md
memory/

# Belt-and-braces: never exclude the vendored rate tables, whatever a broader
# rule above might match. The Dockerfile copies this tree into /app/SBRM_RATE_TABLE.
!rate_tables/**

# Local dev / editor
.venv/
venv/
.env
.env.*
.vscode/
.idea/
